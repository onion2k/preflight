{
  "name": "Preflight Checklist",
  "short_name": "Preflight",
  "description": "A pre-launch checklist for websites: content, accessibility, security, crawler files, performance, error pages, legal and launch day.",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f7f8f6",
